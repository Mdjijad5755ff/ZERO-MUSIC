<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Album Art Thumbnail -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_album_art_desc" />

    <!-- Song Details (Title, Artist, Progress) -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_no_song_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_tap_to_play"
            android:textColor="#FFA8B2C4"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_drawable" />
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Previous Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_circle_bg"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="@string/widget_action_prev"
            android:padding="6dp" />

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_play_pause_bg"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@string/widget_action_play"
            android:padding="8dp" />

        <!-- Next Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_circle_bg"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@string/widget_action_next"
            android:padding="6dp" />
    </LinearLayout>

</LinearLayout>
